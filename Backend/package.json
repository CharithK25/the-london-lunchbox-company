{
  "name": "london-lunchbox-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "db:init": "psql postgresql://admin:secret@localhost:5432/lunchboxdb -f sql/init.sql",
    "db:seed": "psql postgresql://admin:secret@localhost:5432/lunchboxdb -f sql/seed.sql"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.15.5"
  }
}
